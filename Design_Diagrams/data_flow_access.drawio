        </mxCell>
        <mxCell id="note1" value="I3 acknowledgments return to C2 before C2 issues I1 cookies. Session cookies are opaque; provider secrets stay server-side." style="text;html=0;align=left;verticalAlign=middle;fontSize=17;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="25" y="775" width="1355" height="30" as="geometry" />
        </mxCell>
