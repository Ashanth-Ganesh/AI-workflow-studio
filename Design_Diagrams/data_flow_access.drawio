        <mxCell id="note0" value="Stages may repeat a component. OAuth browser redirects are mediated by C1 through I1; provider exchanges belong to I2." style="text;html=0;align=left;verticalAlign=middle;fontSize=17;fontColor=#0f172a;" vertex="1" parent="1">
