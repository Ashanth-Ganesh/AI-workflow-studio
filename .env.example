# Application
APP_ENV=local
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (async SQLAlchemy driver)
DATABASE_URL=postgresql+asyncpg://ai_studio:ai_studio@localhost:5432/ai_studio

# Cookies and server-side sessions. Generate a unique value for every environment.
SESSION_COOKIE_NAME=aiws_session
CSRF_COOKIE_NAME=aiws_csrf
OAUTH_COOKIE_NAME=aiws_oauth
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false

# Human login providers. Register the callback URLs documented in README.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
